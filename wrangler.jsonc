{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "guessdrawing",
  "main": "apps/server/src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  // SQLite-backed Durable Objects are available on the free Workers plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "vars": {
    // Comma separated list of allowed origins, e.g. "https://guessdrawing.vercel.app".
    // Empty allows every origin.
    "CORS_ORIGIN": ""
  }
}
